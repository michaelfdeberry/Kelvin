environment-reading = {
  0: 1,
  1: float,
  2: float,
  3: float,
  * (4..4294967295) => any
}

nullable-float = float / null
schedule-id = bstr .size 16
run-type = 0..1
run-mode = 0..4
minutes = 0..1439

thermostat-state = {
  0: 1,
  1: run-mode,
  2: bool,
  3: float,
  4: nullable-float,
  5: nullable-float,
  6: [* set-point],
  7: [* schedule],
  * (8..4294967295) => any
}
set-point = {1: run-type, 2: float, * (3..4294967295) => any}
schedule = {
  1: schedule-id,
  2: run-type,
  3: minutes,
  4: minutes,
  5: float,
  * (6..4294967295) => any
}
control-state = {
  0: 1,
  1: 0..8,
  2: nullable-float,
  3: nullable-float,
  4: nullable-float,
  5: nullable-float,
  * (6..4294967295) => any
}
preferences = {0: 1, 1: 0..1, 2: 0..1, * (3..4294967295) => any}
sensor-reading = {0: 1, 1: float, 2: float, 3: 0..65535, 4: float, * (5..4294967295) => any}
set-mode = {0: 1, 1: run-mode, * (2..4294967295) => any}
set-fan = {0: 1, 1: bool, * (2..4294967295) => any}
set-set-point = {0: 1, 1: run-type, 2: float, * (3..4294967295) => any}
upsert-schedule = {0: 1, 1: schedule-id / null, 2: run-type, 3: minutes, 4: minutes, 5: float, * (6..4294967295) => any}
remove-schedule = {0: 1, 1: schedule-id, * (2..4294967295) => any}
set-lockouts = {0: 1, 1: nullable-float, 2: nullable-float, * (3..4294967295) => any}
request-state = {0: 1, * (1..4294967295) => any}