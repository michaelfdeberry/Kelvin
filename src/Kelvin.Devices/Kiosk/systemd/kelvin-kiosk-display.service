[Unit]
Description=Kelvin kiosk display (cage + Chromium)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/kelvin/Kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Cage (not Chromium) reads these to pick a cursor theme; pointing at a nonexistent theme hides the cursor.
Environment=XCURSOR_PATH=/dev/null
Environment=XCURSOR_THEME=none
ExecStart=/usr/bin/cage -- /opt/kelvin/Kiosk/scripts/start-browser.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
