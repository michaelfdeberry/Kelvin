[Unit]
Description=Kelvin kiosk sensor service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/kelvin/Kiosk
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kelvin/Kiosk/scripts/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target