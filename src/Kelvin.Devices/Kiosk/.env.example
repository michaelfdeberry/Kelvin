KELVIN_SERVER_URL=http://localhost:5194
KELVIN_UI_URL=http://localhost:5173
KELVIN_SENSOR_TYPE=mock
KELVIN_POLL_INTERVAL_SECONDS=30
KELVIN_HEARTBEAT_SECONDS=300
KELVIN_THRESHOLD_TEMPERATURE_C=0.5
KELVIN_THRESHOLD_HUMIDITY_PERCENT=1.0
