KELVIN_SERVER_URL=http://kelvin.local
KELVIN_UI_URL=http://kelvin.local
KELVIN_SENSOR_TYPE=mock
KELVIN_POLL_INTERVAL_SECONDS=30
KELVIN_HEARTBEAT_SECONDS=300
KELVIN_FAILURE_BACKOFF_SECONDS=10
KELVIN_BROWSER_RESTART_SECONDS=5
KELVIN_THRESHOLD_TEMPERATURE_C=0.5
KELVIN_THRESHOLD_HUMIDITY_PERCENT=1.0
KELVIN_THRESHOLD_CO2_PPM=75
KELVIN_LOG_LEVEL=INFO
KELVIN_BROWSER_ENABLED=true
KELVIN_BROWSER_COMMAND=chromium
KELVIN_CHROMIUM_ARGS=--kiosk --incognito --noerrdialogs --disable-session-crashed-bubble --disable-infobars
KELVIN_MAC_INTERFACE=
KELVIN_I2C_PORT=/dev/i2c-1